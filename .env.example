# MetroDuel environment variables.
# Copy to .env.local and fill in. Every value is OPTIONAL: leaving one empty
# disables the feature it gates (ads / crash reporting) with zero active code paths.

# --- AdMob (all three empty => ads fully off in dev, CI, Jest, Maestro) ---
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ID=

# --- Sentry (empty => crash reporting off) ---
# Must be EXPO_PUBLIC_-prefixed: only EXPO_PUBLIC_ vars are inlined by
# babel-preset-expo into the on-device RN bundle. A plain SENTRY_DSN would
# never be readable at runtime and the gate would never open.
EXPO_PUBLIC_SENTRY_DSN=
